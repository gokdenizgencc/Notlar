<Window x:Class="Notlar.App.DayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notlar" Width="1000" Height="700" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,8" VerticalAlignment="Bottom">
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>

        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,20" FontSize="16">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="Bu günde not yok." Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="NotesList"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
