<UserControl x:Class="Notlar.App.NavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Notlar.App"
             Width="46" Background="{DynamicResource RailBg}">
    <!-- Panelin solundaki dikey ikon şeridi: sekmeler (üstte) ve ⚙ Ayarlar (altta). Etkin öğe Tag="on" ile vurgulanır. -->
    <UserControl.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Item" Width="34" Height="34" CornerRadius="8"
                                Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter TargetName="Item" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,8,0,8" LastChildFill="False">
            <Button x:Name="SettingsItem" DockPanel.Dock="Bottom" Content="⚙" ToolTip="Ayarlar" Margin="0"
                    Style="{StaticResource RailButton}" Click="Item_Click"
                    CommandParameter="{x:Static local:PanelSection.Settings}"/>
            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                <Button x:Name="NotesItem" Content="📝" ToolTip="Notlar (Ctrl+1)"
                        Style="{StaticResource RailButton}" Click="Item_Click"
                        CommandParameter="{x:Static local:PanelSection.Notes}"/>
                <Button x:Name="MemoryItem" Content="🧠" ToolTip="Hafıza (Ctrl+2)"
                        Style="{StaticResource RailButton}" Click="Item_Click"
                        CommandParameter="{x:Static local:PanelSection.Memory}"/>
                <Button x:Name="PlansItem" Content="📋" ToolTip="Planlar (Ctrl+3)"
                        Style="{StaticResource RailButton}" Click="Item_Click"
                        CommandParameter="{x:Static local:PanelSection.Plans}"/>
                <Button x:Name="RecordingsItem" Content="🎙" ToolTip="Kayıtlar (Ctrl+4)"
                        Style="{StaticResource RailButton}" Click="Item_Click"
                        CommandParameter="{x:Static local:PanelSection.Recordings}"/>
                <Button x:Name="SkillsItem" Content="🧩" ToolTip="Yetenekler (Ctrl+5)"
                        Style="{StaticResource RailButton}" Click="Item_Click"
                        CommandParameter="{x:Static local:PanelSection.Skills}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
