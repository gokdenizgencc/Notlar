<UserControl x:Class="Notlar.App.NotificationSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Fg}">
    <!-- ⚙ Ayarlar → Bildirimler. Stiller (SectionTitle, SettingCheck, CheckHint, ActionButton…) SettingsView'dan
         DynamicResource ile alınır. Değişiklikler anında kaydedilir; bkz. Notifier / NotificationPolicy. -->
    <StackPanel>
        <TextBlock Text="Bildirimler" Style="{DynamicResource SectionTitle}"/>

        <CheckBox x:Name="EnabledCheck" Content="Bildirimleri göster" Style="{DynamicResource SettingCheck}"
                  Checked="Check_Changed" Unchecked="Check_Changed"/>
        <TextBlock Style="{DynamicResource CheckHint}"
                   Text="Tepsi simgesinin yanında kısa bildirimler. Kapalıyken de hatalar günlüğe yazılır."/>

        <StackPanel x:Name="DetailPanel" Margin="20,0,0,0">
            <TextBlock Text="Bildirim gönderilecek olaylar" Style="{DynamicResource FieldTitle}"/>
            <CheckBox x:Name="ManualCheck" Content="Kayıt başladı / durdu — elle (tepsi menüsünden)"
                      Style="{DynamicResource SettingCheck}" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="ScheduledCheck" Content="Kayıt başladı / durdu — hafta içi zamanlanmış"
                      Style="{DynamicResource SettingCheck}" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="TeamsCheck" Content="Kayıt başladı / durdu — Teams araması"
                      Style="{DynamicResource SettingCheck}" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="TranscriptCheck" Content="Transkript hazır"
                      Style="{DynamicResource SettingCheck}" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="SummaryCheck" Content="Özet / görevler hazır"
                      Style="{DynamicResource SettingCheck}" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="ErrorsCheck" Content="Hatalar ve uyarılar"
                      Style="{DynamicResource SettingCheck}"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <TextBlock Style="{DynamicResource CheckHint}"
                       Text="Kapalıyken de hatalar günlüğe (log) yazılır. Hatalar rahatsız etmeyin saatlerinde de gösterilir."/>

            <CheckBox x:Name="SoundCheck" Content="Bildirim sesi" Style="{DynamicResource SettingCheck}"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <TextBlock Style="{DynamicResource CheckHint}"
                       Text="Kapalıyken bildirim sessiz gösterilir. Windows'un kendi bildirim/odak ayarları ayrıca geçerlidir."/>

            <CheckBox x:Name="QuietCheck" Content="Rahatsız etmeyin" Style="{DynamicResource SettingCheck}"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                <TextBox x:Name="QuietStartBox" Width="54" MaxLength="5" TextAlignment="Center" Padding="2,3"
                         Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                         CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Border}"
                         ToolTip="Başlangıç saati (SS:dd)" AutomationProperties.Name="Rahatsız etmeyin başlangıç saati"
                         LostKeyboardFocus="QuietTime_LostKeyboardFocus" KeyDown="QuietTime_KeyDown"/>
                <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                <TextBox x:Name="QuietEndBox" Width="54" MaxLength="5" TextAlignment="Center" Padding="2,3"
                         Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                         CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Border}"
                         ToolTip="Bitiş saati (SS:dd)" AutomationProperties.Name="Rahatsız etmeyin bitiş saati"
                         LostKeyboardFocus="QuietTime_LostKeyboardFocus" KeyDown="QuietTime_KeyDown"/>
            </StackPanel>
            <TextBlock Style="{DynamicResource CheckHint}" Margin="20,4,0,12"
                       Text="Bu saatler arasında hata dışındaki bildirimler susturulur. Aralık gece yarısını aşabilir (ör. 22:00–08:00)."/>
        </StackPanel>

        <Button Content="🔔 Örnek bildirim gönder" Style="{DynamicResource ActionButton}" Margin="0,2,0,0"
                Click="TestButton_Click"/>
        <TextBlock x:Name="StatusText" Style="{DynamicResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
