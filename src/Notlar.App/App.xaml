<Application x:Class="Notlar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Renk anahtarları (Bg, Fg, Surface...) Theme.Apply ile bu sözlüğe yazılır; birleştirilen sözlük
             varsayılan WPF denetimlerini (menü, kaydırma çubuğu, açılır kutu, takvim...) bu renklere uydurur. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
