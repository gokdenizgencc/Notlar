<UserControl x:Class="Notlar.App.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Notlar.App"
             Foreground="{DynamicResource Fg}"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kayıt düğmesi: renkleri koddan (SetResourceReference) atanır — boşta Record dolgu, kayıtta çerçeveli. -->
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Record}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnRecord}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Record}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Detaydaki eylem düğmeleri; dar panelde sığmazsa metin "…" ile kısalır (tam metin ToolTip'te). -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TagBg}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Durum rozeti; renk RecordingListItem.Kind'e göre tema kaynaklarından seçilir. -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,0,7,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Muted}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="ToolTip" Value="{Binding StatusToolTip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:RecordingBadgeKind.Recording}">
                    <Setter Property="Background" Value="{DynamicResource Record}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Record}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnRecord}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:RecordingBadgeKind.Running}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:RecordingBadgeKind.Ready}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:RecordingBadgeKind.Error}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Record}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Record}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordingItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="RecordingItem_PreviewMouseLeftButtonUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transkript / Özet sekme düğmeleri (segment). -->
        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="10,6" Margin="0,0,0,-1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ Liste -->
        <Grid x:Name="ListPane" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="RecordButton" Grid.Row="0" Style="{StaticResource RecordButtonStyle}"
                    Margin="10,10,10,6" Padding="10,9" Content="⏺ Kaydı başlat"
                    ToolTip="Mikrofon (Ben) ve bilgisayardan gelen ses (Karşı taraf) kaydedilir; kayıt, siz 📝 Transkript et'e basınca bu bilgisayarda metne çevrilir."
                    Click="RecordButton_Click"/>

            <ListBox x:Name="RecordingsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource Fg}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource RecordingItemStyle}"
                     SelectionMode="Single"
                     SelectionChanged="RecordingsList_SelectionChanged"
                     KeyDown="RecordingsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RecordingListItem}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}"/>
                            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"/>
                                </Border>
                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyListText" Grid.Row="1" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,30,20,0"
                       Visibility="Collapsed"
                       Text="Henüz kayıt yok. Yukarıdaki düğmeyle ya da tepsi menüsünden kayda başlayabilirsiniz."/>
        </Grid>

        <!-- ============================================================ Detay -->
        <Border x:Name="DetailHost" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="NoSelectionText" Text="Bir kayıt seçin." Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dar panel: geri + küçük kayıt düğmesi (liste ekranındaki büyük düğme burada görünmez). -->
                    <DockPanel x:Name="BackBar" Grid.Row="0" Margin="4,4,8,0" LastChildFill="False">
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}"
                                Foreground="{DynamicResource Accent}" FontSize="12" Content="‹ Kayıtlar"
                                ToolTip="Kayıt listesine dön" Click="BackButton_Click"/>
                        <Button x:Name="MiniRecordButton" DockPanel.Dock="Right" Style="{StaticResource RecordButtonStyle}"
                                Padding="9,3" FontSize="11.5" VerticalAlignment="Center" Content="⏺ Kayıt"
                                ToolTip="Yeni kayıt başlat" Click="RecordButton_Click"/>
                    </DockPanel>

                    <TextBox x:Name="TitleBox" Grid.Row="1" Margin="8,6,10,0" FontSize="15" FontWeight="SemiBold"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             Background="Transparent" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                             BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,1"
                             ToolTip="Başlığı düzenleyin; Enter ile ya da başka yere tıklayınca kaydedilir (Esc: vazgeç)"
                             KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostKeyboardFocus"/>

                    <!-- Zaman · süre · dil; altında (varsa) plan · proje · ses notu -->
                    <StackPanel Grid.Row="2" Margin="10,3,10,0">
                        <TextBlock x:Name="MetaText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MetaExtraText" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,1,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Durum + ilerleme + hata -->
                    <StackPanel Grid.Row="3" Margin="10,6,10,0">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="DetailBadge" DockPanel.Dock="Left" Style="{StaticResource StatusBadge}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"/>
                            </Border>
                            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ProgressBar x:Name="TranscribeProgress" Height="4" Margin="0,6,0,0"
                                     Minimum="0" Maximum="1" BorderThickness="0"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface}"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" FontSize="12"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>

                        <!-- Oynatıcı + metne çevrilecek aralıklar (ses dosyası durduğu sürece). -->
                        <StackPanel x:Name="PlayerPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="▶" Width="34"
                                        Style="{StaticResource ActionButton}" Padding="0,5"
                                        ToolTip="Kaydı dinle / duraklat" Click="PlayButton_Click"/>
                                <TextBlock x:Name="PlayerTimeText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" FontSize="11.5" Text="00:00 / 00:00"/>
                                <Grid Margin="6,0,8,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Seçili aralıklar (Accent) ve bekleyen başlangıç işareti (Warning). -->
                                    <Canvas x:Name="RangeStrip" Grid.Row="0" Margin="5,0" IsHitTestVisible="False"
                                            ClipToBounds="True" SizeChanged="RangeStrip_SizeChanged"/>
                                    <Slider x:Name="PositionSlider" Grid.Row="1" Minimum="0" Maximum="1"
                                            IsMoveToPointEnabled="True" Focusable="False"
                                            ToolTip="Kayıtta ileri / geri gidin"
                                            ValueChanged="PositionSlider_ValueChanged"/>
                                </Grid>
                            </DockPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="MarkStartButton" Content="[ Başlangıç" Style="{StaticResource ActionButton}"
                                        Padding="8,3" FontSize="11.5" Margin="0,0,5,0"
                                        ToolTip="Şu anki konumu, metne çevrilecek aralığın başı olarak işaretle"
                                        Click="MarkStartButton_Click"/>
                                <Button x:Name="MarkEndButton" Content="Bitiş ]" Style="{StaticResource ActionButton}"
                                        Padding="8,3" FontSize="11.5" Margin="0,0,8,0"
                                        ToolTip="İşaretli başlangıçtan şu anki konuma kadar olan aralığı ekle"
                                        Click="MarkEndButton_Click"/>
                                <TextBlock x:Name="RangeHintText" VerticalAlignment="Center" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <WrapPanel x:Name="RangeChips" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3 ana eylem + ⋯ -->
                    <local:ActionStrip Grid.Row="4" Margin="10,10,10,0" Spacing="5">
                        <Button x:Name="TranscribeButton" Content="📝 Transkript et" Visibility="Collapsed"
                                Style="{StaticResource PrimaryActionButton}" Click="TranscribeButton_Click"/>
                        <Button x:Name="SummarizeButton" Content="✨ Özetle" Style="{StaticResource PrimaryActionButton}"
                                ToolTip="Transkripti Claude'a özetlet" Click="SummarizeButton_Click"/>
                        <Button x:Name="PlanButton" Content="🗂 Görev çıkart" Style="{StaticResource ActionButton}"
                                Click="PlanButton_Click"/>
                        <Button x:Name="ClaudeButton" Content="💬 Claude" Style="{StaticResource ActionButton}"
                                Click="ClaudeButton_Click"/>
                        <Button x:Name="MoreButton" Content="⋯" Style="{StaticResource ActionButton}" Padding="9,6"
                                ToolTip="Diğer işlemler: yeniden çevir, kopyala, dil, proje, sil" Click="MoreButton_Click"/>
                    </local:ActionStrip>

                    <!-- Transkript / Özet sekmeleri -->
                    <Border Grid.Row="5" Margin="10,10,10,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TranscriptTab" Content="Transkript" GroupName="RecordingDetailTabs"
                                         Style="{StaticResource SegmentTab}" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="SummaryTab" Content="Özet" GroupName="RecordingDetailTabs"
                                         Style="{StaticResource SegmentTab}" Checked="Tab_Checked"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="6" Margin="10,4,4,8">
                        <!-- Transkript: zaman damgası soluk, konuşmacılar renkli; seçilip kopyalanabilir. -->
                        <RichTextBox x:Name="TranscriptBox" IsReadOnly="True" IsDocumentEnabled="False"
                                     Background="Transparent" BorderThickness="0" Padding="0,4,6,0"
                                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                     FontSize="12.5"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="TranscriptPlaceholder" Style="{StaticResource Placeholder}" Margin="0,8,8,0"/>

                        <TextBox x:Name="SummaryBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Padding="0,4,6,0" FontSize="12.5"
                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="SummaryPlaceholder" Style="{StaticResource Placeholder}" Margin="0,8,8,0"
                                   Visibility="Collapsed"
                                   Text="Henüz özet yok. ✨ Özetle ile Claude'a özetletebilirsiniz."/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <!-- Bilgi / hata mesajı: her düzende (liste ya da detay) görünür, 8 sn sonra kendiliğinden kapanır. -->
        <Border x:Name="MessageBar" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                Background="{DynamicResource TagBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="10,6,4,6" Margin="10,0,10,10" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}" Padding="6,0"
                        VerticalAlignment="Top" ToolTip="Kapat" Click="MessageClose_Click"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
