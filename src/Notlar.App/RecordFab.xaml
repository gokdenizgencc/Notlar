<UserControl x:Class="Notlar.App.RecordFab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Panelin sağ altındaki sabit yuvarlak kayıt düğmesi: boştayken ⏺, kayıt sürerken ⏹ + mm:ss (hap biçiminde). -->
    <Button x:Name="FabButton" Click="FabButton_Click" Cursor="Hand" Focusable="False" ToolTip="Toplantı kaydını başlat">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Pill" Background="{DynamicResource Record}" CornerRadius="21"
                        MinWidth="42" Height="42" Padding="12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.88"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.75"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Text="⏺" FontSize="16" Foreground="{DynamicResource OnRecord}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ElapsedText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnRecord}"
                       VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Button>
</UserControl>
