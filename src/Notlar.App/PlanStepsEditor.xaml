<UserControl x:Class="Notlar.App.PlanStepsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Notlar.App"
             Background="Transparent"
             Foreground="{DynamicResource Fg}"
             FontFamily="{DynamicResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="PlanFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Bottom" Content="+ Adım ekle" Style="{StaticResource PlanFlatButton}"
                HorizontalAlignment="Left" Margin="0,6,0,0" Foreground="{DynamicResource Accent}"
                Click="AddStepButton_Click"/>
        <StackPanel x:Name="StepsPanel" Orientation="Vertical"/>
    </DockPanel>
</UserControl>
