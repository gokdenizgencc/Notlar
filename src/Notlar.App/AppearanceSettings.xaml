<UserControl x:Class="Notlar.App.AppearanceSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Fg}">
    <!-- Görünüm ayarları: önizleme, Tema, Vurgu rengi, Yazı, Yoğunluk, Yazar renkleri, Varsayılana dön. Hem
         AppearanceWindow'da hem panelin ⚙ Ayarlar görünümünde kullanılır. Her seçim anında kaydedilip uygulanır
         (kaydırıcılar ve renk kodları kısa bir gecikmeyle). Kendi kaydırma çubuğu yoktur; dar panelde (~300 px)
         taşmasın diye satırlar WrapPanel ile kırılır. -->
    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="AppearanceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Seçenek çipi (segment görünümlü radyo düğmesi). -->
        <Style x:Key="ChoiceChip" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Yuvarlak renk kutucuğu: Background = renk, Foreground = onay işaretinin rengi (kodda verilir). -->
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Border}"
                                     StrokeThickness="1"/>
                            <Path x:Name="Check" Data="M0,4 L3.5,7.5 L10,0.5" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Canlı önizleme: uygulama kaynaklarına bağlıdır, her seçimle güncellenir ── -->
        <Border x:Name="PreviewCard" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="6" TextElement.FontFamily="{DynamicResource AppFont}"
                AutomationProperties.Name="Görünüm önizlemesi">
            <StackPanel>
                <TextBlock Text="Önizleme" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,4"/>
                <Border Background="{DynamicResource NavActiveBg}" CornerRadius="4" Padding="{DynamicResource RowPadding}">
                    <TextBlock x:Name="PreviewNoteText" Text="Toplantı notlarını gözden geçir" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg}"/>
                </Border>
                <Border CornerRadius="4" Padding="{DynamicResource RowPadding}">
                    <WrapPanel>
                        <TextBlock Text="Sunum taslağı" Foreground="{DynamicResource Fg}" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource TagBg}" CornerRadius="8" Padding="6,0" Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="#iş" FontSize="11" Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="09:30" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>
                <WrapPanel Margin="8,6,0,2">
                    <Border Background="{DynamicResource Accent}" CornerRadius="10" Padding="12,3" Margin="0,0,10,4">
                        <TextBlock Text="Kaydet" Foreground="{DynamicResource OnAccent}"/>
                    </Border>
                    <TextBlock Text="Tümünü gör" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                               Margin="0,0,0,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Tema ── -->
        <TextBlock Text="Tema" Style="{StaticResource GroupTitle}"/>
        <WrapPanel>
            <RadioButton x:Name="ThemeSystem" Content="Sistem" Tag="system" Style="{StaticResource ChoiceChip}"
                         Checked="ThemeMode_Checked" ToolTip="Windows'un açık/koyu ayarını izler."/>
            <RadioButton x:Name="ThemeLight" Content="Açık" Tag="light" Style="{StaticResource ChoiceChip}"
                         Checked="ThemeMode_Checked"/>
            <RadioButton x:Name="ThemeDark" Content="Koyu" Tag="dark" Style="{StaticResource ChoiceChip}"
                         Checked="ThemeMode_Checked"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource AppearanceHint}"
                   Text="Sistem: Windows'un uygulama modu değişince Notlar da kendiliğinden değişir."/>

        <!-- ── Vurgu rengi ── -->
        <TextBlock Text="Vurgu rengi" Style="{StaticResource GroupTitle}"/>
        <WrapPanel x:Name="WindowsAccentRow"/>
        <WrapPanel x:Name="SwatchPanel" Margin="0,2,0,0"/>
        <TextBlock x:Name="AccentHint" Style="{StaticResource AppearanceHint}"/>

        <!-- ── Yazı ── -->
        <TextBlock Text="Yazı" Style="{StaticResource GroupTitle}"/>
        <TextBlock Text="Yazı tipi" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" MaxWidth="280" HorizontalContentAlignment="Left"
                  SelectionChanged="FontCombo_SelectionChanged" AutomationProperties.Name="Yazı tipi"/>
        <TextBlock Style="{StaticResource AppearanceHint}" Margin="0,4,0,4"
                   Text="Yalnızca bu bilgisayarda yüklü yazı tipleri gösterilir. Gün ve not editörlerinin metin alanı sabit genişlikli yazıyla kalır."/>

        <TextBlock Text="Gün penceresi yazı boyutu" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="FontSizeSlider" Grid.Column="0" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="FontSizeSlider_ValueChanged" VerticalAlignment="Center"
                    AutomationProperties.Name="Gün penceresi yazı boyutu"/>
            <TextBlock x:Name="FontSizeValueText" Grid.Column="1" Width="32" Margin="8,0,0,0" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        </Grid>

        <TextBlock Text="Not editörü yazı boyutu" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="EditorFontSlider" Grid.Column="0" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="EditorFontSlider_ValueChanged" VerticalAlignment="Center"
                    AutomationProperties.Name="Not editörü yazı boyutu"/>
            <TextBlock x:Name="EditorFontValueText" Grid.Column="1" Width="32" Margin="8,0,0,0" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        </Grid>
        <TextBlock Style="{StaticResource AppearanceHint}"
                   Text="Tam ekran not editöründe Ctrl + tekerlek ile de değişir."/>

        <!-- ── Yoğunluk ── -->
        <TextBlock Text="Yoğunluk" Style="{StaticResource GroupTitle}"/>
        <WrapPanel>
            <RadioButton x:Name="DensityComfortable" Content="Rahat" Tag="comfortable" Style="{StaticResource ChoiceChip}"
                         Checked="Density_Checked"/>
            <RadioButton x:Name="DensityCompact" Content="Sıkı" Tag="compact" Style="{StaticResource ChoiceChip}"
                         Checked="Density_Checked"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource AppearanceHint}"
                   Text="Sıkı: not, görev, hafıza, plan ve kayıt listelerinde satırlar daha az boşlukla, daha çok satır sığacak şekilde gösterilir."/>

        <!-- ── Yazar renkleri ── -->
        <TextBlock Text="Yazar renkleri" Style="{StaticResource GroupTitle}"/>
        <StackPanel x:Name="AuthorColorsPanel"/>

        <Button Content="Görünümü varsayılana döndür" Style="{StaticResource ResetButton}" Margin="0,6,0,0"
                Click="Reset_Click"/>
    </StackPanel>
</UserControl>
