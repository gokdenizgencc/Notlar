<UserControl x:Class="Notlar.App.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ⚙ Ayarlar → Genel'in ek ayarları (başlangıç, kapatma, tepsi tıklaması, her zaman üstte, konum sıfırlama).
         SettingsView'deki "Genel" başlığının ve mevcut üç anahtarın hemen altına yerleşir. Stiller (FieldTitle, Hint,
         Chip, SettingCheck, CheckHint, ActionButton) SettingsView.Resources'tan gelir; bu denetim kendi
         InitializeComponent'inde henüz ağaca bağlı olmadığından DynamicResource ile başvurulur.
         Değişiklikler anında kaydedilir (AppSettings.Update). -->
    <StackPanel>
        <TextBlock Text="Başlangıçta" Style="{DynamicResource FieldTitle}"/>
        <WrapPanel>
            <RadioButton x:Name="StartHidden" Content="Tepside gizli başlat" GroupName="GeneralStartup"
                         Style="{DynamicResource Chip}" Checked="Startup_Checked"/>
            <RadioButton x:Name="StartOpen" Content="Paneli açık başlat" GroupName="GeneralStartup"
                         Style="{DynamicResource Chip}" Checked="Startup_Checked"/>
        </WrapPanel>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,12"
                   Text="Notlar açılınca (ör. Windows ile başlarken) panel hemen gösterilsin mi?"/>

        <TextBlock Text="Panel kapatılınca (Alt+F4)" Style="{DynamicResource FieldTitle}"/>
        <WrapPanel>
            <RadioButton x:Name="CloseToTray" Content="Tepsiye küçült" GroupName="GeneralClose"
                         Style="{DynamicResource Chip}" Checked="Close_Checked"/>
            <RadioButton x:Name="CloseExit" Content="Uygulamadan çık" GroupName="GeneralClose"
                         Style="{DynamicResource Chip}" Checked="Close_Checked"/>
        </WrapPanel>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,12"
                   Text="Tepsiye küçültülünce Notlar arka planda çalışmaya devam eder (otomatik kayıt dahil). — düğmesi ve Esc her zaman yalnızca gizler."/>

        <CheckBox x:Name="ConfirmExitCheck" Content="Çıkarken onay sor" Style="{DynamicResource SettingCheck}"
                  Checked="ConfirmExitCheck_Changed" Unchecked="ConfirmExitCheck_Changed"/>
        <TextBlock Style="{DynamicResource CheckHint}"
                   Text="Tepsi menüsündeki Çıkış ya da Alt+F4 ile çıkmadan önce sorulur."/>

        <TextBlock Text="Tepsi simgesine tıklayınca" Style="{DynamicResource FieldTitle}"/>
        <WrapPanel>
            <RadioButton x:Name="TrayTogglePanel" Content="Paneli aç/kapat" GroupName="GeneralTrayClick"
                         Style="{DynamicResource Chip}" Checked="TrayClick_Checked"/>
            <RadioButton x:Name="TrayOpenToday" Content="Bugünün gün penceresini aç" GroupName="GeneralTrayClick"
                         Style="{DynamicResource Chip}" Checked="TrayClick_Checked"/>
        </WrapPanel>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,12"
                   Text="Sağ tık menüsü her zaman açılır; panel menüdeki Aç ile de gösterilir."/>

        <CheckBox x:Name="AlwaysOnTopCheck" Content="Her zaman üstte" Style="{DynamicResource SettingCheck}"
                  Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>
        <TextBlock Style="{DynamicResource CheckHint}"
                   Text="Panel açıkken diğer pencerelerin üstünde kalır."/>

        <Button Content="↺ Panel konumunu sıfırla" Style="{DynamicResource ActionButton}" Margin="0,2,0,0"
                Click="ResetPosition_Click"/>
        <TextBlock x:Name="ResetHint" Style="{DynamicResource Hint}" Margin="0,4,0,12"
                   Text="Kompakt panel ekranın sağ altına, büyük mod ekranın ortasına döner."/>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource DangerText}"/>
    </StackPanel>
</UserControl>
