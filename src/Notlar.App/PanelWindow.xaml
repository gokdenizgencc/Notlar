                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="SkillNameBox" Background="Transparent" BorderThickness="0" Padding="2"
                                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"/>
                            <TextBlock Text="Yetenek adı" Foreground="{DynamicResource Muted}" Margin="4,2" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SkillNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
