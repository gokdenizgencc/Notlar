                            <TextBox x:Name="PlanDetailPathBox" Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}" Padding="2"
                                     KeyDown="PlanPathEditBox_KeyDown"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding PlanDetailSteps}" ItemTemplate="{StaticResource PlanStepRowTemplate}"/>

                        <Expander x:Name="PlanAddStepExpander" Header="+ Adım ekle" Foreground="{DynamicResource Muted}"
                                  IsExpanded="False" Expanded="PlanAddStepExpander_Expanded" Margin="0,8,0,0">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="✕" ToolTip="Kapat" Click="PlanAddStepClose_Click"
                                                Style="{StaticResource FlatButton}"/>
                                        <TextBox x:Name="PlanNewStepBox" Background="Transparent" BorderThickness="0" Padding="2"
                                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="4"/>
                                    </DockPanel>
                                    <Button Content="Ekle" Click="PlanAddStep_Click" HorizontalAlignment="Right"
                                            Style="{StaticResource FlatButton}" Background="{DynamicResource Accent}"
                                            Foreground="{DynamicResource OnAccent}" Padding="12,4"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="UndoBar" Grid.Row="7" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Kapat" Click="UndoClose_Click"
                        Style="{StaticResource FlatButton}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Geri al" Click="Undo_Click"
                        Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                <TextBlock x:Name="UndoText" Text="Not silindi." VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border x:Name="ErrorBar" Grid.Row="8" Background="{DynamicResource Danger}" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Kapat" Click="ErrorClose_Click"
                        Style="{StaticResource FlatButton}" Foreground="White" Margin="6,0,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
