                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource Muted}"
                                                       Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource Muted}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="DayRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DayRow" Property="Background" Value="{DynamicResource Surface}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Button x:Name="OlderToggle" Content="Daha eski notları göster" Click="OlderToggle_Click"
                            Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"
