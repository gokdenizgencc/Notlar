                </StackPanel>

                <StackPanel x:Name="DayViewPanel" Visibility="Collapsed">
                    <DockPanel Margin="2,0,2,6">
                        <Button DockPanel.Dock="Left" Content="‹ Geri" Click="BackButton_Click"
                                Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"/>
                        <Button DockPanel.Dock="Right" Content="⤢ Büyüt" ToolTip="Büyük pencerede aç" Click="ExpandButton_Click"
                                Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"/>
