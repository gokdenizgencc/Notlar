                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DayListItem}">
                                    <Border x:Name="DayRow" Background="Transparent" Padding="8,8" CornerRadius="4"
                                            Cursor="Hand" MouseLeftButtonDown="DayRow_MouseLeftButtonDown">
