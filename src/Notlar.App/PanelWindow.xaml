                            Style="{StaticResource FlatButton}" Padding="8,2" Margin="0,0,4,0"/>
                    <Button x:Name="SkillShowDiscoverButton" Content="Keşfet" Click="SkillShowDiscover_Click"
                            Style="{StaticResource FlatButton}" Padding="8,2"/>
                </StackPanel>
            </DockPanel>
            <DockPanel x:Name="SkillStatusRow" Margin="0,0,0,4" Visibility="Collapsed" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Kapat" Click="SkillStatusClose_Click"
                        Style="{StaticResource FlatButton}"/>
                <TextBlock x:Name="SkillStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
            </DockPanel>
            <DockPanel x:Name="SkillSortRow" LastChildFill="False" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="SkillSortUsageButton" Content="Kullanıma göre" Click="SkillSortUsage_Click"
                            Style="{StaticResource FlatButton}" Padding="8,2" Margin="0,0,4,0"/>
                    <Button x:Name="SkillSortNameButton" Content="Ada göre" Click="SkillSortName_Click"
                            Style="{StaticResource FlatButton}" Padding="8,2"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="↻ Yenile" ToolTip="Yeniden tara" Click="SkillRefresh_Click"
                        Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}" Padding="8,2"/>
            </DockPanel>
            <Expander x:Name="SkillAddExpander" Header="+ Elle ekle" Foreground="{DynamicResource Muted}" IsExpanded="False"
                      Expanded="SkillAddExpander_Expanded">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Kapat" Click="SkillAddClose_Click"
                                    Style="{StaticResource FlatButton}"/>
                            <TextBlock DockPanel.Dock="Left" Text="AI:" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SkillAiBox" IsEditable="True" Width="120" HorizontalAlignment="Left"
