<Window x:Class="Notlar.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notlar.App"
        Title="Notlar" Width="360" Height="520"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        BorderBrush="{DynamicResource Border}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NoteRowTemplate" DataType="{x:Type local:NoteItem}">
            <Border x:Name="Row" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,5" CornerRadius="4"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=OneWay}"
                              Click="Done_Click" Focusable="False"
                              VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}"/>
                        <Border x:Name="AuthorBadge" CornerRadius="8" Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                Background="{Binding AuthorTint}">
                            <TextBlock x:Name="AuthorBadgeText" Text="{Binding AuthorLabel}" FontSize="10"
                                       Foreground="{Binding AuthorColor}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="NoteText" Text="{Binding DisplayText}" TextWrapping="Wrap"
                                       Foreground="{Binding AuthorColor}"
                                       MouseLeftButtonDown="NoteText_MouseLeftButtonDown"/>
                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TagBg}" CornerRadius="8"
                                                Padding="6,0" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBox Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                 CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                 TextWrapping="Wrap" Padding="2"
                                 KeyDown="EditBox_KeyDown"
                                 LostKeyboardFocus="EditBox_LostKeyboardFocus"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"/>
                    </StackPanel>
                    <Button x:Name="DeleteButton" Grid.Column="3" Content="🗑" ToolTip="Sil"
                            Style="{StaticResource FlatButton}" Visibility="Hidden"
                            VerticalAlignment="Top" Click="DeleteButton_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="NoteText" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type local:TaskItemVm}">
            <Border x:Name="TaskRow" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,5" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=OneWay}"
                              Click="TaskDone_Click" Focusable="False"
                              VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" TextWrapping="Wrap"
                                   Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"
                                   MouseLeftButtonDown="TaskTitle_MouseLeftButtonDown"/>
                        <TextBox Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                 CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                 TextWrapping="Wrap" Padding="2"
                                 KeyDown="TaskEditBox_KeyDown"
                                 LostKeyboardFocus="TaskEditBox_LostKeyboardFocus"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="8" Padding="5,0" Margin="4,0,8,0" VerticalAlignment="Top"
                            Background="{Binding AuthorTint}">
                        <TextBlock Text="{Binding Author}" FontSize="10" Foreground="{Binding AuthorColor}"/>
                    </Border>
                    <Button x:Name="TaskDeleteButton" Grid.Column="3" Content="🗑" ToolTip="Sil"
                            Style="{StaticResource FlatButton}" Visibility="Hidden"
                            VerticalAlignment="Top" Click="TaskDeleteButton_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TaskRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TaskRow" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="TaskDeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="TaskTitleText" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MemoryRowTemplate" DataType="{x:Type local:MemoryItemVm}">
            <Border x:Name="MemRow" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,6" CornerRadius="4"
                    MouseLeftButtonDown="MemoryRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Opacity="0.85"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Opacity="0.7"
                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                     FontWeight="SemiBold" Padding="2" Margin="0,0,0,4"
                                     KeyDown="MemoryTitleEditBox_KeyDown"
                                     IsVisibleChanged="EditBox_IsVisibleChanged"/>
                            <TextBox Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="6" Padding="2"
                                     KeyDown="MemoryContentEditBox_KeyDown"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="MemoryDeleteButton" Grid.Column="1" Content="🗑" ToolTip="Sil"
                            Style="{StaticResource FlatButton}" Visibility="Hidden"
                            VerticalAlignment="Top" Click="MemoryDeleteButton_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="MemRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="MemRow" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="MemoryDeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="📝 Notlar" FontSize="15" FontWeight="SemiBold" Margin="14,12,14,8"
                   MouseLeftButtonDown="HeaderText_MouseLeftButtonDown"/>

        <StackPanel x:Name="TabsRow" Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,8">
            <Button x:Name="NotesTabButton" Content="📝 Notlar" Click="NotesTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="MemoryTabButton" Content="🧠 Hafıza" Click="MemoryTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4"/>
        </StackPanel>

        <Border x:Name="NotesInputBorder" Grid.Row="2" Margin="12,0,12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0" Padding="8,7"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                         KeyDown="InputBox_KeyDown"/>
                <TextBlock x:Name="InputPlaceholder" Text="Bugüne not yaz... (#etiket)" Foreground="{DynamicResource Muted}"
                           Margin="11,7" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border x:Name="TaskInputBorder" Grid.Row="2" Margin="12,0,12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
            <Grid>
                <TextBox x:Name="TaskInputBox" Background="Transparent" BorderThickness="0" Padding="8,7"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                         KeyDown="TaskInputBox_KeyDown"/>
                <TextBlock Text="Kişisel plan ya da iş yaz..." Foreground="{DynamicResource Muted}"
                           Margin="11,7" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TaskInputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel x:Name="MemoryInputPanel" Grid.Row="2" Margin="12,0,12,8" Visibility="Collapsed">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                    <TextBox x:Name="MemorySearchBox" Background="Transparent" BorderThickness="0" Padding="8,7"
                             Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                             TextChanged="MemorySearchBox_TextChanged"/>
                    <TextBlock Text="Hafızada ara..." Foreground="{DynamicResource Muted}"
                               Margin="11,7" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=MemorySearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="8,6">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBox x:Name="MemoryTitleBox" Background="Transparent" BorderThickness="0" Padding="2"
                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"/>
                        <TextBlock Text="Başlık" Foreground="{DynamicResource Muted}" Margin="4,2" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MemoryTitleBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBox x:Name="MemoryContentBox" Background="Transparent" BorderThickness="0" Padding="2"
                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="4"/>
                        <TextBlock Text="İçerik" Foreground="{DynamicResource Muted}" Margin="4,2"
                                   IsHitTestVisible="False" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MemoryContentBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <DockPanel LastChildFill="False">
                        <ComboBox x:Name="MemoryCategoryBox" DockPanel.Dock="Left" Width="120" IsEditable="True"
                                  Text="genel" ItemsSource="{Binding MemoryCategories}" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="Ekle" Click="MemoryAdd_Click"
                                Style="{StaticResource FlatButton}" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource OnAccent}" Padding="12,4"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ItemsControl x:Name="AuthorFilterRow" Grid.Row="3" ItemsSource="{Binding AuthorFilters}" Margin="12,0,12,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:AuthorChip}">
                    <Button Content="{Binding Label}" Click="AuthorChip_Click" Margin="0,0,6,4" Padding="10,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{Binding Color}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TagRow" Grid.Row="4" ItemsSource="{Binding Tags}" Margin="12,0,12,6" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:TagChip}">
                    <Button Content="{Binding Label}" Click="TagChip_Click" Margin="0,0,6,4" Padding="10,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Padding="6,0,6,8">
            <Grid>
                <StackPanel x:Name="DayListPanel">
                    <DockPanel Margin="2,0,2,6" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="📅 Başka gün" Click="OtherDayButton_Click"
                                Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"/>
                        <DatePicker x:Name="OtherDayPicker" DockPanel.Dock="Left" Visibility="Collapsed"
                                    Margin="8,0,0,0" Width="130"
                                    SelectedDateChanged="OtherDayPicker_SelectedDateChanged"/>
                    </DockPanel>
                    <Grid>
                        <TextBlock x:Name="EmptyText" Text="Henüz not yok." Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DayListItem}">
                                    <Border x:Name="DayRow" Background="Transparent" Padding="8,8" CornerRadius="4"
                                            Cursor="Hand" MouseLeftButtonDown="DayRow_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource Muted}"
                                                       Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource Muted}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="DayRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DayRow" Property="Background" Value="{DynamicResource Surface}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Button x:Name="OlderToggle" Content="Daha eski notları göster" Click="OlderToggle_Click"
                            Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="DayViewPanel" Visibility="Collapsed">
                    <DockPanel Margin="2,0,2,6">
                        <Button DockPanel.Dock="Left" Content="‹ Geri" Click="BackButton_Click"
                                Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"/>
                        <Button DockPanel.Dock="Right" Content="⤢ Büyüt" ToolTip="Büyük pencerede aç" Click="ExpandButton_Click"
                                Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock x:Name="DayViewHeader" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="DayViewEmptyText" Text="Bu günde not yok." Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed"/>
                    <ItemsControl ItemsSource="{Binding DayNotes}" ItemTemplate="{StaticResource NoteRowTemplate}"/>
                </StackPanel>

                <StackPanel x:Name="TasksPanel" Visibility="Collapsed">
                    <TextBlock x:Name="TasksEmptyText" Text="Henüz kişisel kayıt yok." Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                    <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </StackPanel>

                <StackPanel x:Name="MemoryPanel" Visibility="Collapsed">
                    <TextBlock x:Name="MemoryEmptyText" Text="Henüz hafıza kaydı yok. Claude öğrendiklerini buraya yazacak."
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="24,40,24,0" Visibility="Collapsed"/>
                    <ItemsControl ItemsSource="{Binding MemoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MemoryGroupVm}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}" Margin="8,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource MemoryRowTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="UndoBar" Grid.Row="6" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Geri al" Click="Undo_Click"
                        Style="{StaticResource FlatButton}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                <TextBlock x:Name="UndoText" Text="Not silindi." VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border x:Name="ErrorBar" Grid.Row="7" Background="{DynamicResource Danger}" Padding="12,6" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
