                        <Button Content="Ekle" Click="SkillAdd_Click" HorizontalAlignment="Right"
                                Style="{StaticResource FlatButton}" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource OnAccent}" Padding="12,4"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="12,0,12,4" LastChildFill="True">
            <Button x:Name="FilterClearButton" DockPanel.Dock="Right" Content="✕" ToolTip="Filtreyi temizle"
                    Click="FilterClear_Click" Style="{StaticResource FlatButton}" Visibility="Collapsed"/>
