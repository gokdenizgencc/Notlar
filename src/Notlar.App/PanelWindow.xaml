<Window x:Class="Notlar.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notlar.App"
        Title="Notlar" Width="360" Height="520"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        BorderBrush="{DynamicResource Border}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NoteRowTemplate" DataType="{x:Type local:NoteItem}">
            <Border x:Name="Row" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,5" CornerRadius="4"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=OneWay}"
                              Click="Done_Click" Focusable="False"
                              VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}"/>
                        <Border x:Name="AuthorBadge" CornerRadius="8" Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                Background="{Binding AuthorTint}">
                            <TextBlock x:Name="AuthorBadgeText" Text="{Binding AuthorLabel}" FontSize="10"
                                       Foreground="{Binding AuthorColor}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="NoteText" Text="{Binding DisplayText}" TextWrapping="Wrap"
                                       Foreground="{Binding AuthorColor}"/>
                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TagBg}" CornerRadius="8"
                                                Padding="6,0" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Vazgeç" VerticalAlignment="Top"
                                    Style="{StaticResource FlatButton}" Click="CancelNoteEditButton_Click"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                     TextWrapping="Wrap" Padding="2"
                                     KeyDown="EditBox_KeyDown"
                                     LostKeyboardFocus="EditBox_LostKeyboardFocus"
                                     IsVisibleChanged="EditBox_IsVisibleChanged"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="EditButton" Content="✏️" ToolTip="Düzenle"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="EditNoteButton_Click"/>
                        <Button x:Name="DeleteButton" Content="🗑" ToolTip="Sil"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="NoteText" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type local:TaskItemVm}">
            <Border x:Name="TaskRow" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,5" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=OneWay}"
                              Click="TaskDone_Click" Focusable="False"
                              VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" TextWrapping="Wrap"
                                   Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Vazgeç" VerticalAlignment="Top"
                                    Style="{StaticResource FlatButton}" Click="CancelTaskEditButton_Click"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                     TextWrapping="Wrap" Padding="2"
                                     KeyDown="TaskEditBox_KeyDown"
                                     LostKeyboardFocus="TaskEditBox_LostKeyboardFocus"
                                     IsVisibleChanged="EditBox_IsVisibleChanged"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="8" Padding="5,0" Margin="4,0,8,0" VerticalAlignment="Top"
                            Background="{Binding AuthorTint}">
                        <TextBlock Text="{Binding Author}" FontSize="10" Foreground="{Binding AuthorColor}"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="TaskEditButton" Content="✏️" ToolTip="Düzenle"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="TaskEditButton_Click"/>
                        <Button x:Name="TaskDeleteButton" Content="🗑" ToolTip="Sil"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="TaskDeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TaskRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TaskRow" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="TaskEditButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TaskDeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="TaskTitleText" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MemoryRowTemplate" DataType="{x:Type local:MemoryItemVm}">
            <Border x:Name="MemRow" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,6" CornerRadius="4"
                    MouseLeftButtonDown="MemoryRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Opacity="0.85"
                                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Opacity="0.7"
                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Vazgeç"
                                        Style="{StaticResource FlatButton}" Click="CancelMemoryEditButton_Click"/>
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                         CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                         FontWeight="SemiBold" Padding="2"
                                         KeyDown="MemoryTitleEditBox_KeyDown"
                                         IsVisibleChanged="EditBox_IsVisibleChanged"/>
                            </DockPanel>
                            <TextBox Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                     CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="6" Padding="2"
                                     KeyDown="MemoryContentEditBox_KeyDown"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MemoryEditButton" Content="✏️" ToolTip="Düzenle"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="MemoryEditButton_Click"/>
                        <Button x:Name="MemoryDeleteButton" Content="🗑" ToolTip="Sil"
                                Style="{StaticResource FlatButton}" Visibility="Hidden"
                                Click="MemoryDeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="MemRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="MemRow" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="MemoryEditButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="MemoryDeleteButton" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SkillRowTemplate" DataType="{x:Type local:SkillItemVm}">
            <Border x:Name="SkillRow" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" Padding="8,6" CornerRadius="4">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource TagBg}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                            </Border>
                        </StackPanel>
                        <Border MaxHeight="34" ClipToBounds="True" Margin="0,2,0,0" ToolTip="{Binding OriginalDescription}">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UsageLabel}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                            <Button x:Name="SkillDeleteButton" Content="🗑" ToolTip="Sil" Margin="6,0,0,0"
                                    Click="SkillDeleteButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanDelete}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LastUsedLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="SkillRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="SkillRow" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MarketplaceRowTemplate" DataType="{x:Type local:MarketplacePluginVm}">
            <Border x:Name="MarketRow" Background="Transparent" Padding="8,6" CornerRadius="4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource TagBg}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                VerticalAlignment="Center" Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="kurulu" FontSize="11" Foreground="{DynamicResource Accent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,4"
                               Foreground="{DynamicResource Muted}"/>
                    <ItemsControl ItemsSource="{Binding Skills}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource TagBg}" CornerRadius="8"
                                        Padding="6,0" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ActionLabel}" Click="MarketplaceAction_Click"
                            HorizontalAlignment="Right" Padding="12,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Danger}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="MarketRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="MarketRow" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlanRowTemplate" DataType="{x:Type local:PlanListItemVm}">
            <Border x:Name="PlanRow" Background="Transparent" Padding="8,6" CornerRadius="4" Cursor="Hand"
                    MouseLeftButtonDown="PlanRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border Background="{Binding StatusBrush}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ProjectShort}" Foreground="{DynamicResource Muted}" FontSize="11"
                                   Margin="0,2,0,0" ToolTip="{Binding ProjectPath}"/>
                        <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource Muted}" FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="▶" ToolTip="Çalıştır" Style="{StaticResource FlatButton}" Click="PlanRunRow_Click"/>
                        <Button Content="↺" ToolTip="Sıfırla" Style="{StaticResource FlatButton}" Click="PlanResetRow_Click"/>
                        <Button Content="🗑" ToolTip="Sil" Style="{StaticResource FlatButton}" Click="PlanDeleteRow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="PlanRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="PlanRow" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlanStepRowTemplate" DataType="{x:Type local:PlanStepItemVm}">
            <Border x:Name="PlanStepRow" Background="Transparent" Padding="8,6" CornerRadius="4">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" ToolTip="{Binding StatusLabel}"
                                       Margin="0,0,6,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="↑" ToolTip="Yukarı taşı" Style="{StaticResource FlatButton}" Click="PlanStepUp_Click"/>
                                <Button Content="↓" ToolTip="Aşağı taşı" Style="{StaticResource FlatButton}" Click="PlanStepDown_Click"/>
                                <Button Content="✏️" ToolTip="Düzenle" Style="{StaticResource FlatButton}" Click="PlanStepEdit_Click"/>
                                <Button Content="🗑" ToolTip="Sil" Style="{StaticResource FlatButton}" Click="PlanStepDelete_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Result}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   FontSize="11" Margin="22,2,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="✕" ToolTip="Vazgeç" VerticalAlignment="Top"
                                Style="{StaticResource FlatButton}" Click="PlanStepEditCancel_Click"/>
                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
                                 CaretBrush="{DynamicResource Fg}" BorderBrush="{DynamicResource Accent}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="1" MaxLines="4" Padding="2"
                                 KeyDown="PlanStepEditBox_KeyDown" IsVisibleChanged="EditBox_IsVisibleChanged"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="PlanStepRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="PlanStepRow" Property="Background" Value="{DynamicResource Surface}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="DragBar" Grid.Row="0" Height="28" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Cursor="SizeAll" ToolTip="Sürükleyerek taşı"
                MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="⠿" Foreground="{DynamicResource Muted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="PinButton" Content="📌" ToolTip="Sabitle" Click="PinButton_Click"
                            Style="{StaticResource FlatButton}" Padding="6,2"/>
                    <Button x:Name="SizeToggleButton" Content="⤢" ToolTip="Genişlet" Click="SizeToggleButton_Click"
                            Style="{StaticResource FlatButton}" Padding="6,2" Margin="2,0,0,0"/>
                    <Button Content="—" ToolTip="Gizle" Click="HideButton_Click"
                            Style="{StaticResource FlatButton}" Padding="8,2" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel x:Name="HeaderBar" Grid.Row="1" Margin="14,10,10,6" LastChildFill="True"
                   MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <TextBlock x:Name="HeaderText" Text="📝 Notlar" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       MouseLeftButtonDown="HeaderText_MouseLeftButtonDown"/>
        </DockPanel>

        <StackPanel x:Name="TabsRow" Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,8">
            <Button x:Name="NotesTabButton" Content="📝 Notlar" Click="NotesTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="MemoryTabButton" Content="🧠 Hafıza" Click="MemoryTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="SkillsTabButton" Content="🧩 Yetenekler" Click="SkillsTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="PlansTabButton" Content="📋 Planlar" Click="PlansTab_Click"
                    Style="{StaticResource FlatButton}" Padding="10,4"/>
        </StackPanel>

        <Border x:Name="NotesInputBorder" Grid.Row="3" Margin="12,0,12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0" Padding="8,7"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                         KeyDown="InputBox_KeyDown"/>
                <TextBlock x:Name="InputPlaceholder" Text="Bugüne not yaz... (#etiket)" Foreground="{DynamicResource Muted}"
                           Margin="11,7" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border x:Name="TaskInputBorder" Grid.Row="3" Margin="12,0,12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
            <Grid>
                <TextBox x:Name="TaskInputBox" Background="Transparent" BorderThickness="0" Padding="8,7"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                         KeyDown="TaskInputBox_KeyDown"/>
                <TextBlock Text="Kişisel plan ya da iş yaz..." Foreground="{DynamicResource Muted}"
                           Margin="11,7" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TaskInputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel x:Name="MemoryInputPanel" Grid.Row="3" Margin="12,0,12,8" Visibility="Collapsed">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                    <TextBox x:Name="MemorySearchBox" Background="Transparent" BorderThickness="0" Padding="8,7,28,7"
                             Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                             TextChanged="MemorySearchBox_TextChanged"/>
                    <TextBlock Text="Hafızada ara..." Foreground="{DynamicResource Muted}"
                               Margin="11,7" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
